# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROJECT_NAME="Base Blast"
NEXT_PUBLIC_ONCHAINKIT_API_KEY=""
NEXT_PUBLIC_URL=""

# ── Leaderboard (onchain) ────────────────────────────────────────────────────
# Deployed contract address. Leave empty and the leaderboard runs offline.
NEXT_PUBLIC_LEADERBOARD_ADDRESS=""
# 84532 = Base Sepolia (testnet), 8453 = Base mainnet
NEXT_PUBLIC_CHAIN_ID="84532"
# (optional) CDP Paymaster URL for gasless submits from a smart wallet
NEXT_PUBLIC_PAYMASTER_URL=""

# ── Verifier (SECRET, server only, never commit the real value) ─────────────
# Private key of the trusted signer. Its address = SIGNER_ADDRESS at deploy.
SIGNER_PRIVATE_KEY=""

# ── Deploy (contracts/, local only, for forge) ───────────────────────────────
# DEPLOYER_PRIVATE_KEY=""      # deployer (becomes owner), needs test ETH on Base Sepolia
# SIGNER_ADDRESS=""            # address of SIGNER_PRIVATE_KEY above
# BASE_SEPOLIA_RPC="https://sepolia.base.org"
# BASE_RPC="https://mainnet.base.org"
# BASESCAN_API_KEY=""          # to verify the contract on Basescan
